{
	"manifest_version": 3,
	"name": "Grindr OAuth",
	"homepage_url": "https://github.com/imaoreo/grindr-oauth-webextension",
	"version": "1.0.6",
	"description": "Grindr Google and Apple sign-in token extractor for Native Grind",
	"minimum_chrome_version": "102",
	"icons": {
		"16": "icons/icon-16.png",
		"32": "icons/icon-32.png",
		"48": "icons/icon-48.png",
		"128": "icons/icon-128.png"
	},
	"content_security_policy": {
		"extension_pages": "script-src 'self'; object-src 'self'"
	},
	"permissions": ["storage"],
	"action": { "default_title": "Sign in to Grindr" },
	"background": { "service_worker": "shared/background.js" },
	"content_scripts": [
		{
			"matches": ["https://web.grindr.com/*"],
			"js": ["shared/oauth-ui.js", "shared/content.js"],
			"css": ["shared/oauth-ui.css"],
			"run_at": "document_start"
		}
	],
	"web_accessible_resources": [
		{
			"resources": [
				"shared/gis-core.js",
				"shared/apple-core.js",
				"shared/page-runner.js"
			],
			"matches": ["https://web.grindr.com/*"]
		}
	]
}
